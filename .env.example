# Auth (NextAuth/Auth.js)
AUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (Turso libSQL in production, local SQLite for dev)
# Local: DATABASE_URL="file:./dev.db"
# Production: DATABASE_URL="libsql://your-db.turso.io" + TURSO_AUTH_TOKEN
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=

# WhatsApp engine (Railway container)
WHATSAPP_ENGINE_URL=http://localhost:3001
WHATSAPP_ENGINE_TOKEN=replace-with-a-long-random-secret

# Cron job authentication (Vercel Cron Jobs)
# Vercel auto-sends CRON_SECRET as an Authorization: Bearer header on cron
# invocations. The route also accepts CRON_SECRET_TOKEN (query param) for
# backward compatibility. Set them to the same random secret.
CRON_SECRET=replace-with-a-long-random-secret
CRON_SECRET_TOKEN=replace-with-a-long-random-secret